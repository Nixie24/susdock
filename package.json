{
    "name": "susdock",
    "kernelsu": {
        "name": "SusDock",
        "updateJson": "https://raw.githubusercontent.com/Nixie24/susdock/refs/heads/update/update.json"
    },
    "type": "module",
    "version": "0.3.6",
    "private": true,
    "packageManager": "pnpm@12.14.0",
    "description": "A SuSFS Manager for LKM Setups",
    "author": {
        "name": "Nix24",
        "email": "nix24nya@gmail.com",
        "url": "https://nixy.ing"
    },
    "license": "GPL-2.0-only",
    "scripts": {
        "dev": "pnpm --filter webui run dev",
        "build": "jiti scripts/build.ts",
        "pack": "jiti scripts/pack.ts",
        "test": "bash tests/run.sh",
        "webui:build": "pnpm --filter webui run build",
        "lint": "eslint",
        "commit:lint": "commitfmt --lint",
        "prepare": "git config core.hooksPath .githooks || true",
        "postinstall": "shellcheck --version > /dev/null",
        "sync": "syncpack"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.14.0",
            "onFail": "download"
        }
    },
    "devDependencies": {
        "@antfu/eslint-config": "9.5.1",
        "@types/node": "26.4.0",
        "commitfmt": "1.3.0",
        "eslint": "10.12.0",
        "eslint-plugin-format": "2.0.1",
        "jiti": "2.7.0",
        "prettier-plugin-css-order": "2.2.0",
        "prettier-plugin-sh": "0.20.2",
        "shellcheck": "^4.1.0",
        "syncpack": "15.3.3",
        "typescript": "6.0.3"
    }
}
